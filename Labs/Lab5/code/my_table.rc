#include <windows.h>
#include <commctrl.h>

501 DIALOGEX 0, 0, 340, 180
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Objects table"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", 502, "SysListView32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 5, 5, 330, 150
    PUSHBUTTON "Delete", 503, 230, 160, 50, 14
    PUSHBUTTON "Close", IDCANCEL, 285, 160, 50, 14
END
